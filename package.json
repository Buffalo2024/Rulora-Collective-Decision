  "dependencies": {
    "@langchain/core": "1.2.5",
    "@langchain/langgraph": "1.4.9",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "1.0.0",
    "pdfjs-dist": "4.10.38",
    "pg-boss": "10.4.2"
  },
