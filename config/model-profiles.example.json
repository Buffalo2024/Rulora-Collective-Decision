{
  "contract_version": "1.0.0",
  "profiles": {
    "chain_reasoner": {
      "provider": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "base_url_env": "CHAIN_LLM_BASE_URL",
      "api_key_env": "CHAIN_LLM_API_KEY",
      "model": "gpt-5.6-terra",
      "model_env": "CHAIN_LLM_MODEL",
      "temperature": 0.1,
      "timeout_ms": 120000,
      "max_retries": 2,
      "json_mode": true,
      "extra_body": {
        "reasoning_effort": "medium"
      }
    },
    "factor_reasoner": {
      "provider": "anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "base_url_env": "FACTOR_LLM_BASE_URL",
      "api_key_env": "FACTOR_LLM_API_KEY",
      "model": "claude-sonnet-4-5",
      "model_env": "FACTOR_LLM_MODEL",
      "temperature": 0.1,
      "max_tokens": 7000,
      "timeout_ms": 120000,
      "max_retries": 2
    },
    "red_team_reasoner": {
      "provider": "openai_compatible",
      "base_url": "https://openrouter.ai/api/v1",
      "base_url_env": "REDTEAM_LLM_BASE_URL",
      "api_key_env": "REDTEAM_LLM_API_KEY",
      "model": "anthropic/claude-sonnet-4.5",
      "model_env": "REDTEAM_LLM_MODEL",
      "temperature": 0.2,
      "timeout_ms": 120000,
      "max_retries": 2,
      "json_mode": true
    },
    "credit_reasoner": {
      "provider": "openai_compatible",
      "base_url": "http://127.0.0.1:11434/v1",
      "base_url_env": "CREDIT_LLM_BASE_URL",
      "api_key_env": "CREDIT_LLM_API_KEY",
      "api_key_optional": true,
      "model": "qwen3:30b-a3b",
      "model_env": "CREDIT_LLM_MODEL",
      "temperature": 0.1,
      "timeout_ms": 180000,
      "max_retries": 1,
      "json_mode": true
    },
    "monitor_extractor": {
      "provider": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "base_url_env": "MONITOR_LLM_BASE_URL",
      "api_key_env": "MONITOR_LLM_API_KEY",
      "model": "gpt-5.6-luna",
      "model_env": "MONITOR_LLM_MODEL",
      "temperature": 0,
      "timeout_ms": 60000,
      "max_retries": 2,
      "json_mode": true,
      "extra_body": {
        "reasoning_effort": "low"
      }
    }
  }
}
